<Window x:Class="LanShare.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:infra="clr-namespace:LanShare.Infrastructure"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:LanShare.Models"
        mc:Ignorable="d"
        Title="LanShare"
        Width="1480"
        Height="940"
        MinWidth="1260"
        MinHeight="800"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6F8">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="VisibilityConverter" />
        <infra:SystemFileIconConverter x:Key="SystemFileIconConverter" />

        <Style x:Key="ShellSurfaceStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D6D9DE" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="84" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Foreground" Value="#1F2937" />
            <Setter Property="Background" Value="#FBFBFC" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="PrimaryToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="Background" Value="#EAF2FF" />
            <Setter Property="BorderBrush" Value="#9DBAF3" />
            <Setter Property="Foreground" Value="#174EA6" />
        </Style>

        <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#5F6B7A" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="ListHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#202938" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderBrush" Value="#C9CED6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
        </Style>

        <Style TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}" />

        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D6D9DE" />
        </Style>

        <Style x:Key="NavToggleStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#243041" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root"
                                Padding="{TemplateBinding Padding}"
                                Background="#F8F9FB"
                                BorderBrush="#D6D9DE"
                                BorderThickness="1"
                                CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#EAF2FF" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#9DBAF3" />
                                <Setter Property="Foreground" Value="#174EA6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource ShellSurfaceStyle}"
                Padding="16,12"
                Background="#FCFCFD">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="#1E293B"
                               Text="LanShare" />
                    <TextBlock Margin="0,4,0,0"
                               Style="{StaticResource CaptionTextStyle}"
                               Text="局域网共享目录浏览与传输" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right"
                            HorizontalAlignment="Right">
                    <TextBlock HorizontalAlignment="Right"
                               FontWeight="SemiBold"
                               Foreground="#1E293B"
                               Text="{Binding CurrentModeLabel}" />
                    <TextBlock Margin="0,4,0,0"
                               HorizontalAlignment="Right"
                               Style="{StaticResource CaptionTextStyle}"
                               Text="{Binding StatusMessage}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1"
                Margin="0,10,0,10"
                Style="{StaticResource ShellSurfaceStyle}"
                Padding="12,10"
                Background="#FFFFFF">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Left">
                    <RadioButton Content="客户端浏览"
                                 GroupName="ModeSelector"
                                 Style="{StaticResource NavToggleStyle}"
                                 IsChecked="{Binding IsClientMode}" />
                    <RadioButton Content="服务端管理"
                                 GroupName="ModeSelector"
                                 Style="{StaticResource NavToggleStyle}"
                                 IsChecked="{Binding IsServerMode}"
                                 Visibility="{Binding IsServerVisible, Converter={StaticResource VisibilityConverter}}" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Command="{Binding RequestServerAccessCommand}"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Content="管理入口" />
                    <Button Command="{Binding HideServerAccessCommand}"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Visibility="{Binding IsServerVisible, Converter={StaticResource VisibilityConverter}}"
                            Content="隐藏服务端" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid Visibility="{Binding IsClientMode, Converter={StaticResource VisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Style="{StaticResource ShellSurfaceStyle}"
                        Padding="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Margin="2,0,10,0"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Foreground="#243041"
                                   Text="地址" />
                        <TextBox x:Name="ServerAddressInputTextBox"
                                 Grid.Column="1"
                                 Margin="0"
                                 Height="34"
                                 VerticalContentAlignment="Center"
                                 KeyDown="ServerAddressInputTextBox_KeyDown"
                                 Text="{Binding Client.ServerAddressInput, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="2"
                                Margin="8,0,0,0"
                                Style="{StaticResource PrimaryToolbarButtonStyle}"
                                Command="{Binding Client.ConnectToServerCommand}"
                                Content="连接" />
                        <Button Grid.Column="3"
                                Margin="6,0,0,0"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Command="{Binding Client.BrowseSelectedServerCommand}"
                                Content="刷新" />
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Margin="0,10,0,10"
                        Style="{StaticResource ShellSurfaceStyle}"
                        Padding="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button Style="{StaticResource ToolbarButtonStyle}"
                                    Command="{Binding Client.NavigateUpCommand}"
                                    Content="返回上级" />
                            <Button Style="{StaticResource ToolbarButtonStyle}"
                                    Command="{Binding Client.OpenSelectedDirectoryCommand}"
                                    Content="进入目录" />
                            <Button Style="{StaticResource ToolbarButtonStyle}"
                                    Command="{Binding Client.UploadToSelectedDirectoryCommand}"
                                    Content="上传" />
                            <Button Style="{StaticResource ToolbarButtonStyle}"
                                    Command="{Binding Client.DownloadSelectedItemCommand}"
                                    Content="下载" />
                            <Button Style="{StaticResource ToolbarButtonStyle}"
                                    Command="{Binding Client.DeleteSelectedEntryCommand}"
                                    Content="删除" />
                        </StackPanel>

                        <Grid Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Margin="0"
                                     Height="34"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding Client.DownloadFolder, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1"
                                    Margin="6,0,0,0"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Command="{Binding Client.BrowseDownloadFolderCommand}"
                                    Content="下载目录" />
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        Style="{StaticResource ShellSurfaceStyle}"
                        Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0"
                              Margin="12,10,12,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock VerticalAlignment="Center"
                                       Style="{StaticResource ListHeaderStyle}"
                                       Text="{Binding Client.CurrentPathDisplay, StringFormat=当前目录: {0}}" />
                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Text="{Binding Client.ClientStatus}" />
                        </Grid>

                        <DataGrid Grid.Row="1"
                                  AllowDrop="True"
                                  DragOver="ClientEntriesDataGrid_DragOver"
                                  Drop="ClientEntriesDataGrid_Drop"
                                  ItemsSource="{Binding Client.Entries}"
                                  SelectedItem="{Binding Client.SelectedEntry}"
                                  MouseDoubleClick="ClientEntriesDataGrid_MouseDoubleClick">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="新建文件夹"
                                              Command="{Binding PlacementTarget.DataContext.Client.CreateFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="*"
                                                        Header="名称">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type models:BrowseEntry}">
                                            <Grid VerticalAlignment="Center" Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="24" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Image Grid.Column="0"
                                                       Width="16"
                                                       Height="16"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       Source="{Binding ., Converter={StaticResource SystemFileIconConverter}}"
                                                       Stretch="Uniform" />
                                                <TextBlock Grid.Column="1"
                                                           Margin="8,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="#1F2937"
                                                           Text="{Binding Name}" />
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Width="100" Binding="{Binding EntryType}" Header="类型" />
                                <DataGridTextColumn Width="120" Binding="{Binding SizeText}" Header="大小" />
                                <DataGridTextColumn Width="170" Binding="{Binding LastModifiedText}" Header="修改时间" />
                                <DataGridTextColumn Width="120" Binding="{Binding PermissionSummary}" Header="权限" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <Border Grid.Row="3"
                        Margin="0,10,0,0"
                        Style="{StaticResource ShellSurfaceStyle}"
                        Padding="12,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="240" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock FontWeight="SemiBold"
                                       Foreground="#1E293B"
                                       Text="{Binding Client.TransferTitle}" />
                            <TextBlock Margin="0,4,0,0"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Text="{Binding Client.TransferProgressText}" />
                        </StackPanel>

                        <ProgressBar Grid.Column="1"
                                     Height="14"
                                     Margin="12,8,0,8"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{Binding Client.TransferProgressValue, Mode=OneWay}"
                                     IsIndeterminate="{Binding Client.IsTransferIndeterminate, Mode=OneWay}" />
                    </Grid>
                </Border>
            </Grid>

            <Grid Visibility="{Binding IsServerMode, Converter={StaticResource VisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="400" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource ShellSurfaceStyle}" Padding="14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource ListHeaderStyle}" Text="服务配置" />

                            <TextBlock Margin="0,14,0,0" Style="{StaticResource CaptionTextStyle}" Text="共享目录" />
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Margin="0"
                                         Text="{Binding Server.SharedFolderPath, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1"
                                        Margin="8,0,0,0"
                                        Style="{StaticResource ToolbarButtonStyle}"
                                        Command="{Binding Server.BrowseFolderCommand}"
                                        Content="选择目录" />
                            </Grid>

                            <TextBlock Margin="0,14,0,0" Style="{StaticResource CaptionTextStyle}" Text="服务端口" />
                            <TextBox Text="{Binding Server.ServicePort}" />

                            <TextBlock Margin="0,14,0,0" Style="{StaticResource CaptionTextStyle}" Text="发现端口" />
                            <TextBox Text="{Binding Server.DiscoveryPort}" />

                            <TextBlock Margin="0,14,0,0" Style="{StaticResource CaptionTextStyle}" Text="服务器名称" />
                            <TextBox Text="{Binding Server.ServerName}" />

                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Style="{StaticResource PrimaryToolbarButtonStyle}"
                                        Command="{Binding Server.StartServerCommand}"
                                        Content="启动服务" />
                                <Button Style="{StaticResource ToolbarButtonStyle}"
                                        Command="{Binding Server.StopServerCommand}"
                                        Content="停止服务" />
                                <Button Style="{StaticResource ToolbarButtonStyle}"
                                        Command="{Binding Server.SaveConfigCommand}"
                                        Content="保存配置" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Margin="0,10,0,0" Style="{StaticResource ShellSurfaceStyle}" Padding="14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource ListHeaderStyle}" Text="运行状态" />
                            <TextBlock Margin="0,10,0,0"
                                       FontWeight="SemiBold"
                                       Foreground="#1E293B"
                                       Text="{Binding Server.ServerStatus}" />
                            <TextBlock Margin="0,6,0,0"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Text="{Binding Server.ServerEndpoint}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Margin="0,10,0,0" Style="{StaticResource ShellSurfaceStyle}" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Style="{StaticResource ListHeaderStyle}" Text="连接列表" />
                            <ListBox Grid.Row="1"
                                     Margin="0,12,0,0"
                                     ItemsSource="{Binding Server.ConnectedClients}"
                                     BorderBrush="#D6D9DE"
                                     BorderThickness="1"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:ConnectedClientInfo}">
                                        <Border Padding="8,7" BorderBrush="#EAECF0" BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <TextBlock FontWeight="SemiBold"
                                                           Foreground="#101828"
                                                           Text="{Binding DisplayName}" />
                                                <TextBlock Grid.Row="1"
                                                           Margin="0,4,0,0"
                                                           Style="{StaticResource CaptionTextStyle}"
                                                           Text="{Binding LastSeenLocalTime, StringFormat=最后活跃: {0:HH:mm:ss}}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource ShellSurfaceStyle}" Padding="14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource ListHeaderStyle}" Text="{Binding Server.PermissionEditorTitle}" />
                            <TextBlock Margin="0,6,0,0"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Text="新增规则会追加；加载选中规则后保存，只会替换当前这条规则。完全相同的重复规则不会再次添加。" />

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource CaptionTextStyle}" Text="用户" />
                                    <ComboBox ItemsSource="{Binding Server.Users}"
                                              DisplayMemberPath="UserName"
                                              SelectedValuePath="UserName"
                                              SelectedValue="{Binding Server.SelectedRuleUserName}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource CaptionTextStyle}" Text="规则效果" />
                                    <ComboBox ItemsSource="{Binding Server.RuleEffects}"
                                              SelectedItem="{Binding Server.SelectedRuleEffect}" />
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Style="{StaticResource CaptionTextStyle}" Text="相对路径" />
                                    <TextBox Text="{Binding Server.RuleDirectoryPath}" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <CheckBox Margin="0,0,16,0" Content="Read" IsChecked="{Binding Server.RuleRead}" />
                                <CheckBox Margin="0,0,16,0" Content="Write" IsChecked="{Binding Server.RuleWrite}" />
                                <CheckBox Margin="0,0,16,0" Content="Delete" IsChecked="{Binding Server.RuleDelete}" />
                                <CheckBox Content="继承到子目录" IsChecked="{Binding Server.RuleInheritToChildren}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Style="{StaticResource PrimaryToolbarButtonStyle}"
                                        Command="{Binding Server.SavePermissionRuleCommand}"
                                        Content="{Binding Server.SavePermissionRuleButtonText}" />
                                <Button Style="{StaticResource ToolbarButtonStyle}"
                                        Command="{Binding Server.LoadSelectedRuleCommand}"
                                        Content="加载选中" />
                                <Button Style="{StaticResource ToolbarButtonStyle}"
                                        Command="{Binding Server.ResetPermissionEditorCommand}"
                                        Content="清空编辑器" />
                                <Button Style="{StaticResource ToolbarButtonStyle}"
                                        Command="{Binding Server.RemovePermissionRuleCommand}"
                                        Content="删除选中" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="320" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource ShellSurfaceStyle}" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock Style="{StaticResource ListHeaderStyle}" Text="权限规则" />
                                <DataGrid Grid.Row="1"
                                          Margin="0,12,0,0"
                                          ItemsSource="{Binding Server.PermissionRules}"
                                          SelectedItem="{Binding Server.SelectedPermissionRule}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Width="100" Binding="{Binding UserName}" Header="用户" />
                                        <DataGridTextColumn Width="220" Binding="{Binding DirectoryLabel}" Header="路径" />
                                        <DataGridTextColumn Width="90" Binding="{Binding EffectLabel}" Header="效果" />
                                        <DataGridTextColumn Width="170" Binding="{Binding PermissionsLabel}" Header="权限" />
                                        <DataGridTextColumn Width="150" Binding="{Binding ScopeLabel}" Header="范围" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource ShellSurfaceStyle}" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock Style="{StaticResource ListHeaderStyle}" Text="共享目录扫描结果" />
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,12">
                                    <Button Style="{StaticResource ToolbarButtonStyle}"
                                            Command="{Binding Server.RefreshSharedPathsCommand}"
                                            Content="重新扫描" />
                                    <Button Style="{StaticResource ToolbarButtonStyle}"
                                            Command="{Binding Server.UseSelectedSharedPathCommand}"
                                            Content="使用选中路径" />
                                </StackPanel>

                                <ListBox Grid.Row="2"
                                         ItemsSource="{Binding Server.SharedPaths}"
                                         SelectedItem="{Binding Server.SelectedSharedPath}"
                                         BorderBrush="#D6D9DE"
                                         BorderThickness="1"
                                         MouseDoubleClick="SharedPathsListBox_MouseDoubleClick">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:SharedPathItem}">
                                            <StackPanel Margin="6">
                                                <TextBlock Text="{Binding DisplayPath}" />
                                                <TextBlock FontSize="12" Foreground="#667085" Text="{Binding TypeLabel}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="3"
                Margin="0,10,0,0"
                Style="{StaticResource ShellSurfaceStyle}"
                Padding="10,8"
                Background="#FCFCFD">
            <TextBlock Foreground="#667085"
                       Text="{Binding FooterMessage}" />
        </Border>
    </Grid>
</Window>
