<Window x:Class="LanShare.ServerApp.ServerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:LanShare.Infrastructure"
        xmlns:models="clr-namespace:LanShare.Models"
        Title="局域网共享-服务端"
        Width="1500"
        Height="940"
        MinWidth="1240"
        MinHeight="820"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8">
    <Window.Resources>
        <infra:SystemFileIconConverter x:Key="SystemFileIconConverter" />

        <Style x:Key="SurfaceStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D7DBE2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="86" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#CFD6DF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#1F2937" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="Background" Value="#E7F0FF" />
            <Setter Property="BorderBrush" Value="#A9C3F5" />
            <Setter Property="Foreground" Value="#1D4ED8" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderBrush" Value="#C9D1DA" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource SurfaceStyle}" Padding="18,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock FontSize="24" FontWeight="SemiBold" Foreground="#0F172A" Text="局域网共享-服务端" />
                    <TextBlock Margin="0,4,0,0" Foreground="#64748B" Text="共享目录、权限规则与服务运行管理" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding ServerStatus}" />
                    <TextBlock Margin="0,4,0,0" HorizontalAlignment="Right" Foreground="#64748B" Text="{Binding ServerEndpoint}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="410" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource SurfaceStyle}" Padding="14">
                    <StackPanel>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" Text="服务配置" />
                        <TextBlock Margin="0,14,0,0" Foreground="#64748B" Text="共享目录" />
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding SharedFolderPath, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding BrowseFolderCommand}" Content="浏览" />
                        </Grid>

                        <TextBlock Margin="0,14,0,0" Foreground="#64748B" Text="服务端口" />
                        <TextBox Text="{Binding ServicePort}" />

                        <TextBlock Margin="0,14,0,0" Foreground="#64748B" Text="发现端口" />
                        <TextBox Text="{Binding DiscoveryPort}" />

                        <TextBlock Margin="0,14,0,0" Foreground="#64748B" Text="服务名称" />
                        <TextBox Text="{Binding ServerName}" />

                        <StackPanel Margin="0,16,0,0" Orientation="Horizontal">
                            <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding StartServerCommand}" Content="启动服务" />
                            <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding StopServerCommand}" Content="停止服务" />
                            <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding SaveConfigCommand}" Content="保存配置" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Margin="0,12,0,0" Style="{StaticResource SurfaceStyle}" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" Text="连接列表" />
                        <ListBox Grid.Row="1"
                                 Margin="0,12,0,0"
                                 BorderBrush="#D7DBE2"
                                 BorderThickness="1"
                                 ItemsSource="{Binding ConnectedClients}">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:ConnectedClientInfo}">
                                    <Border Padding="8,7" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock FontWeight="SemiBold" Foreground="#111827" Text="{Binding DisplayName}" />
                                            <TextBlock Grid.Row="1"
                                                       Margin="0,4,0,0"
                                                       Foreground="#64748B"
                                                       Text="{Binding LastSeenLocalTime, StringFormat=最后活跃：{0:yyyy-MM-dd HH:mm:ss}}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource SurfaceStyle}" Padding="14">
                    <StackPanel>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding PermissionEditorTitle}" />
                        <TextBlock Margin="0,6,0,0"
                                   Foreground="#64748B"
                                   Text="相对路径可以直接从共享目录预览里点选。新增规则会追加，编辑规则保存时只替换当前这一条。" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Foreground="#64748B" Text="用户" />
                                <ComboBox ItemsSource="{Binding Users}"
                                          DisplayMemberPath="UserName"
                                          SelectedValuePath="UserName"
                                          SelectedValue="{Binding SelectedRuleUserName}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Foreground="#64748B" Text="规则效果" />
                                <ComboBox ItemsSource="{Binding RuleEffects}" SelectedItem="{Binding SelectedRuleEffect}" />
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Foreground="#64748B" Text="相对路径" />
                                <TextBox Text="{Binding RuleDirectoryPath, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
                            <CheckBox Margin="0,0,16,0" Content="Read" IsChecked="{Binding RuleRead}" />
                            <CheckBox Margin="0,0,16,0" Content="Write" IsChecked="{Binding RuleWrite}" />
                            <CheckBox Margin="0,0,16,0" Content="Delete" IsChecked="{Binding RuleDelete}" />
                            <CheckBox Content="继承到子目录" IsChecked="{Binding RuleInheritToChildren}" />
                        </StackPanel>

                        <StackPanel Margin="0,16,0,0" Orientation="Horizontal">
                            <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SavePermissionRuleCommand}" Content="{Binding SavePermissionRuleButtonText}" />
                            <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding LoadSelectedRuleCommand}" Content="加载选中" />
                            <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding ResetPermissionEditorCommand}" Content="清空编辑器" />
                            <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding RemovePermissionRuleCommand}" Content="删除选中" />
                            <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding RefreshSharedPathsCommand}" Content="刷新预览" />
                        </StackPanel>

                        <TextBlock Margin="0,18,0,0" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding SharedPathPreviewTitle}" />
                        <TextBlock Margin="0,4,0,0" Foreground="#64748B" Text="单击文件或文件夹即可把相对路径填入上方输入框，根目录用 / 表示。" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Command="{Binding NavigateUpSharedPathCommand}"
                                    Content="返回上级" />
                            <TextBox Grid.Column="2"
                                     Height="34"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding SharedPathSearchText, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="#64748B"
                                   Text="{Binding CurrentSharedBrowseDisplay, StringFormat=当前目录：{0}}" />
                        <DataGrid Margin="0,10,0,0"
                                  Height="260"
                                  BorderBrush="#D7DBE2"
                                  BorderThickness="1"
                                  Background="White"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column"
                                  ItemsSource="{Binding SharedPaths}"
                                  SelectedItem="{Binding SelectedSharedPath}"
                                  MouseDoubleClick="SharedPathsDataGrid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="*" Header="名称">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type models:SharedPathItem}">
                                            <Grid Margin="0,3" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="24" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Image Grid.Column="0"
                                                       Width="16"
                                                       Height="16"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Stretch="Uniform"
                                                       Source="{Binding ., Converter={StaticResource SystemFileIconConverter}}" />
                                                <TextBlock Grid.Column="1"
                                                           Margin="8,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="#111827"
                                                           Text="{Binding DisplayPath}" />
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Width="110" Binding="{Binding TypeLabel}" Header="类型" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Margin="0,12,0,0" Style="{StaticResource SurfaceStyle}" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" Text="权限规则列表" />
                        <DataGrid Grid.Row="1"
                                  Margin="0,12,0,0"
                                  ItemsSource="{Binding PermissionRules}"
                                  SelectedItem="{Binding SelectedPermissionRule}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="100" Binding="{Binding UserName}" Header="用户" />
                                <DataGridTextColumn Width="220" Binding="{Binding DirectoryLabel}" Header="路径" />
                                <DataGridTextColumn Width="90" Binding="{Binding EffectLabel}" Header="效果" />
                                <DataGridTextColumn Width="170" Binding="{Binding PermissionsLabel}" Header="权限" />
                                <DataGridTextColumn Width="150" Binding="{Binding ScopeLabel}" Header="范围" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
