<Window x:Class="LanShare.ClientApp.ClientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:LanShare.Infrastructure"
        xmlns:models="clr-namespace:LanShare.Models"
        Title="局域网共享-客户端"
        Width="1380"
        Height="900"
        MinWidth="1120"
        MinHeight="760"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <infra:SystemFileIconConverter x:Key="SystemFileIconConverter" />
        <Style x:Key="RefreshRetryTextStyle" TargetType="TextBlock">
            <Setter Property="Text" Value="刷新" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedServer}" Value="{x:Null}">
                    <Setter Property="Text" Value="重试" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SurfaceStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D7DBE2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="86" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#CFD6DF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#1F2937" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="Background" Value="#E7F0FF" />
            <Setter Property="BorderBrush" Value="#A9C3F5" />
            <Setter Property="Foreground" Value="#1D4ED8" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderBrush" Value="#C9D1DA" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="White" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource SurfaceStyle}" Padding="18,14">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock FontSize="24" FontWeight="SemiBold" Foreground="#0F172A" Text="局域网共享-客户端" />
                    <TextBlock Margin="0,4,0,0" Foreground="#64748B" Text="自动连接共享服务并浏览目录内容" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding ClientStatus}" />
                    <TextBlock Margin="0,4,0,0" HorizontalAlignment="Right" Foreground="#64748B" Text="{Binding CurrentPathDisplay, StringFormat=当前目录：{0}}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Margin="0,12,0,12" Style="{StaticResource SurfaceStyle}" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding NavigateUpCommand}" Content="返回上级" />
                    <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding OpenSelectedDirectoryCommand}" Content="进入目录" />
                    <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding UploadToSelectedDirectoryCommand}" Content="上传文件" />
                    <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding DownloadSelectedItemCommand}" Content="下载" />
                    <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding DeleteSelectedEntryCommand}" Content="删除" />
                    <Grid Margin="10,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Height="34"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding DownloadFolder, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1"
                                Margin="8,0,0,0"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Command="{Binding BrowseDownloadFolderCommand}"
                                Content="浏览下载目录" />
                    </Grid>
                </StackPanel>
                <Button Grid.Column="1"
                        Margin="12,0,0,0"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Command="{Binding BrowseSelectedServerCommand}">
                    <TextBlock Style="{StaticResource RefreshRetryTextStyle}" />
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource SurfaceStyle}">
            <DataGrid x:Name="ClientEntriesDataGrid"
                      AllowDrop="True"
                      DragOver="ClientEntriesDataGrid_DragOver"
                      Drop="ClientEntriesDataGrid_Drop"
                      ItemsSource="{Binding Entries}"
                      SelectedItem="{Binding SelectedEntry}"
                      MouseDoubleClick="ClientEntriesDataGrid_MouseDoubleClick">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="新建文件夹"
                                  Command="{Binding PlacementTarget.DataContext.CreateFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="*" Header="名称">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type models:BrowseEntry}">
                                <Grid Margin="0,3" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Column="0"
                                           Width="16"
                                           Height="16"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Stretch="Uniform"
                                           Source="{Binding ., Converter={StaticResource SystemFileIconConverter}}" />
                                    <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#111827" Text="{Binding Name}" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Width="100" Binding="{Binding EntryType}" Header="类型" />
                    <DataGridTextColumn Width="120" Binding="{Binding SizeText}" Header="大小" />
                    <DataGridTextColumn Width="170" Binding="{Binding LastModifiedText}" Header="修改时间" />
                    <DataGridTextColumn Width="120" Binding="{Binding PermissionSummary}" Header="权限" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="3" Margin="0,12,0,0" Style="{StaticResource SurfaceStyle}" Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="260" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding TransferTitle}" />
                    <TextBlock Margin="0,4,0,0" Foreground="#64748B" Text="{Binding TransferProgressText}" />
                </StackPanel>
                <ProgressBar Grid.Column="1"
                             Height="14"
                             Margin="12,8,0,8"
                             Minimum="0"
                             Maximum="100"
                             Value="{Binding TransferProgressValue, Mode=OneWay}"
                             IsIndeterminate="{Binding IsTransferIndeterminate, Mode=OneWay}" />
            </Grid>
        </Border>
    </Grid>
</Window>
